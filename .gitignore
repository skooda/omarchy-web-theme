# OS cruft
.DS_Store
Thumbs.db

# Editor cruft
*.swp
*.swo
*.bak
*~

# Python
__pycache__/
*.pyc
*.pyo

# The generated native-messaging host manifests live outside this repo, in each
# browser's NativeMessagingHosts/ dir — produced by install.sh.

# The private half of the extension signing key. Only the PUBLIC half is checked
# in (as "key" in extension/manifest.json), which is all that's needed to pin the
# extension ID. This .pem is required only to package a .crx or claim the same ID
# on the Chrome Web Store — losing it forfeits that ability permanently, so keep
# a backup somewhere outside the repo.
*.pem

# Release build artifacts (build-firefox.sh / sign-firefox.sh).
build/
dist/

# AMO API credentials for sign-firefox.sh — never commit these.
.env
